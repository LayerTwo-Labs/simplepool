<!doctype html>
<html lang="en">
<head>
<%# Via the partial, so a saved dark theme applies here too — this page used
    to hand-roll its own <head> and was the one page that ignored it. No nav,
    so no toggle: there is nothing on a 404 worth staying to re-theme. %>
<%- include('partial/head', { title: '404 · simplepool' }) %>
</head>
<body>
    <header class="top">
        <a href="/" class="brand">simplepool</a>
        <span class="tag">404</span>
    </header>
    <main class="wrap">
        <section class="card">
            <h2>not found</h2>
            <p>No such <%= what %>.</p>
            <p><a href="/">← back to overview</a></p>
        </section>
    </main>
</body>
</html>
