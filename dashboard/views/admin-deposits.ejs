<!doctype html>
<html lang="en">
<head>
<%- include('partial/head', { title: 'admin · deposits · simplepool', refresh: 30 }) %>
</head>
<body>
<%- include('partial/nav-admin', { active: 'deposits' }) %>
<main class="wrap">
    <%- include('partial/flash', { flash }) %>

    <section class="card info">
        <h2>Deposits (mainchain → Thunder)</h2>
        <p class="muted small">
            The pool operator batches accumulated BTC into Thunder here.
            Each deposit spends enforcer-wallet UTXOs into a BIP300
            sidechain-#<%= reserveSidechainId %> tx; the enforcer signs and
            broadcasts, the mainchain confirms, and Thunder eventually
            processes the deposit into a spendable UTXO the payout worker
            can draw from.
        </p>
    </section>

    <section class="card">
        <h2>Fund the reserve</h2>
        <% if (enforcer.ok) { %>
            <p class="muted small" style="margin-top:0">
                <strong>Enforcer wallet spendable:</strong>
                <%= fmtSats(enforcer.confirmed_sats) %>
                <% if (enforcer.pending_sats > 0) { %>
                    &nbsp;(+<%= fmtSats(enforcer.pending_sats) %> pending)
                <% } %>
            </p>
        <% } else { %>
            <p class="muted small" style="margin-top:0;color:#c66">
                Enforcer gRPC unreachable: <em><%= enforcer.error %></em>
            </p>
        <% } %>

        <form method="POST" action="/admin/action/deposit" style="max-width:640px">
            <input type="hidden" name="csrf" value="<%= csrfToken %>">
            <input type="hidden" name="return_to" value="/admin/deposits">
            <input type="hidden" name="sidechain_id" value="<%= reserveSidechainId %>">

            <label class="small muted">Recipient (Thunder address)</label>
            <input type="text" name="address"
                   value="<%= reserveAddress === '(unset)' ? '' : reserveAddress %>"
                   required minlength="8" maxlength="128"
                   style="width:100%;font-family:monospace;padding:0.35em;margin-bottom:0.5em">

            <label class="small muted">Value (sats)</label>
            <input type="number" name="value_sats" min="1" step="1" required
                   placeholder="e.g. 100000000 for 1 BTC"
                   style="width:100%;padding:0.35em;margin-bottom:0.5em">

            <label class="small muted">Fee (sats)</label>
            <input type="number" name="fee_sats" min="0" step="1" value="100"
                   style="width:100%;padding:0.35em;margin-bottom:0.75em">

            <button type="submit">Submit deposit</button>
        </form>
    </section>

    <%
    /* depositStatus is only populated on this page; fall back to the plain
     * ledger if the probe was skipped entirely. */
    const ds       = typeof depositStatus !== 'undefined' ? depositStatus : null;
    const rows     = ds ? ds.rows : deposits.map(d => ({ ...d, status: null }));
    const reserve_ = ds ? ds.reserve : null;
    /* The state worth shouting about: money irreversibly on the mainchain
     * that Thunder has not turned into anything spendable. */
    const settled  = rows.filter(r => r.status && r.status.ok).length;
    const stranded = settled > 0 && reserve_ && reserve_.ok && reserve_.total === 0;
    %>

    <section class="card">
        <h2>History</h2>

        <form method="POST" action="/admin/action/check-deposits" style="margin:0 0 0.75em">
            <input type="hidden" name="csrf" value="<%= csrfToken %>">
            <input type="hidden" name="return_to" value="/admin/deposits">
            <button type="submit">Check deposit status now</button>
            <span class="muted small" style="margin-left:0.6em">
                Re-reads the enforcer and Thunder. The table below already
                refreshes every 30s; this answers in words.
            </span>
        </form>

        <% if (ds && ds.errors && ds.errors.length) { %>
            <p class="muted small" style="color:#c66;margin-top:0">
                ⚠ Status probe incomplete: <%= ds.errors.join('; ') %>.
                Amounts and txids below are from the pool's own ledger and
                are unaffected.
            </p>
        <% } %>

        <% if (stranded) { %>
            <p class="small" style="color:#c66;margin-top:0">
                ⚠ <strong><%= settled %> deposit(s) are confirmed on the mainchain,
                but the Thunder reserve is 0.</strong>
                A deposit only becomes spendable when the sidechain advances a
                block and ingests it. Thunder is not producing blocks, so these
                funds are irreversibly committed and not yet usable — payouts
                stay blocked until it does. Use <em>Nudge Thunder to mine</em>
                on the Tools page, or wait for a BMM miner.
            </p>
        <% } %>

        <% if (rows.length === 0) { %>
            <p class="muted">No deposits recorded.</p>
        <% } else { %>
        <table>
            <thead><tr>
                <th>When</th><th>Amount</th><th>Fee</th>
                <th>Status</th>
                <th>Thunder recipient</th><th>Mainchain txid</th>
            </tr></thead>
            <tbody>
                <% rows.forEach(d => { const s = d.status; %>
                <tr>
                    <td class="muted small" title="<%= fmtTs(d.ts) %>"><%= ago(d.ts) %></td>
                    <td><strong><%= fmtSats(d.sats_deposited) %></strong></td>
                    <td class="muted small"><%= fmtSats(d.fee_sats) %></td>
                    <td class="small">
                        <% if (!s) { %>
                            <span class="muted">unknown</span>
                        <% } else { %>
                            <span style="color:<%= s.ok ? '#5b8' : '#c66' %>">
                                <%= s.ok ? '✓' : '○' %> <%= s.label %>
                            </span>
                            <% if (s.height) { %>
                                <br><span class="muted">block <%= fmtN(s.height) %></span>
                            <% } %>
                            <br><span class="muted" title="<%= s.detail %>"><%= s.detail %></span>
                        <% } %>
                    </td>
                    <td class="mono small"><%= d.thunder_recipient %></td>
                    <td class="mono small" title="<%= d.btc_txid %>"><%= d.btc_txid.slice(0,16) %>…<%= d.btc_txid.slice(-6) %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>

        <p class="muted small" style="margin-top:0.75em">
            A deposit passes through four stages:
            <strong>broadcast</strong> → <strong>confirmed</strong> on the
            mainchain → recognised as the sidechain's <strong>Ctip</strong> →
            <strong>credited</strong> on Thunder. Only the last one makes the
            funds spendable by the payout worker, and it needs the sidechain to
            advance a block.
            <% if (ds) { %>
                Mainchain tip <strong><%= fmtN(ds.tipHeight) %></strong>;
                Thunder reserve
                <strong><%= reserve_ && reserve_.ok ? fmtSats(reserve_.total) : 'unreachable' %></strong>.
            <% } %>
        </p>
        <% } %>
    </section>
    <%- include('partial/tx-attempts', {
            attempts: txAttempts.filter(a => a.kind === 'deposit'),
            kindLabel: 'Deposit broadcast attempts' }) %>

</main>
<footer class="foot">
    <span>auto-refresh 30s</span>
    <span class="sep">·</span>
    <span>admin · deposits</span>
</footer>
</body>
</html>
