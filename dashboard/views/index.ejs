<%
/* Same shortening /blocks uses. The full hash stays in the title attribute —
 * it is a value you copy, not one you read across, and at 64 characters it
 * was setting the width of the whole table. */
const shortHash = (h) => h ? (h.slice(0, 10) + '…' + h.slice(-8)) : '—';
%>
<!doctype html>
<html lang="en">
<head>
<%- include('partial/head', { title: 'overview · simplepool', refresh: 15 }) %>
</head>
<body>
<%- include('partial/nav-public', { active: 'overview' }) %>
<main class="wrap">
        <% if (!ov.db_ready) { %>
            <div class="card warn">
                <h2>no data yet</h2>
                <p>The proxy database isn't readable yet. Either the proxy hasn't started or no shares have been submitted.</p>
            </div>
        <% } %>

        <%- include('partial/about-numbers') %>

        <section class="card">
            <h2>Bitcoin node tip</h2>
            <% if (!node || node.tip_height == null) { %>
                <p class="muted">The proxy hasn't reported a tip yet — usually means it can't reach bitcoind.</p>
            <% } else { %>
            <div class="grid">
                <div><label>Height</label><strong><%= fmtN(node.tip_height) %></strong></div>
                <%# Difficulty is not part of the tip poll — it is read off the
                    block template the proxy last built a job from. So it gets
                    its own "as of", and says so when there isn't one: a chain
                    whose difficulty is unknown must not render as a chain at
                    difficulty zero. %>
                <div><label>Network difficulty</label>
                    <% if (node.network_difficulty) { %>
                    <strong title="Exactly <%= node.network_difficulty %>, derived from the block template the proxy is currently mining<%= node.network_difficulty_at ? ' — as of ' + fmtTs(node.network_difficulty_at) : '' %>."><%= fmtDifficulty(node.network_difficulty) %></strong>
                    <% } else { %>
                    <strong class="muted" title="The proxy publishes the difficulty with each block template it builds a job from. Nothing has been published yet.">—</strong>
                    <% } %>
                </div>
                <div><label>Time since last block</label><strong title="<%= fmtTs(node.tip_observed_at) %>"><%= ago(node.tip_observed_at) %></strong></div>
                <div><label>Last poll</label><strong title="<%= fmtTs(node.updated_at) %>"><%= ago(node.updated_at) %></strong></div>
            </div>
            <p class="mono small muted" style="margin-top:0.6em; word-break:break-all"><%= node.tip_hash %></p>
            <% } %>
        </section>

        <section class="card">
            <h2>Pool hashrate</h2>
            <div class="grid">
                <div><label>Last 5 min</label><strong><%= fmtHashrate(ov.hashrate_5m) %></strong></div>
                <div><label>Last 1 h</label><strong><%= fmtHashrate(ov.hashrate_1h) %></strong></div>
                <div><label>Last 24 h avg</label><strong><%= fmtHashrate(ov.hashrate) %></strong></div>
                <div><label>Active workers (24h)</label><strong><%= fmtN(ov.workers_active) %></strong></div>
                <div><label>Last share</label><strong title="<%= fmtTs(ov.last_share_ts) %>"><%= ago(ov.last_share_ts) %></strong></div>
            </div>
        </section>

        <%# 24h and lifetime were two cards of the same five figures, which is
            two cards' worth of page for one comparison. Same numbers, one
            card: the 24h row is what you came for, the lifetime row sits
            under it in the quieter .grid-sub tiles. Nothing is dropped. %>
        <section class="card">
            <h2>Shares</h2>
            <h3 class="subhead">Last 24h</h3>
            <div class="grid">
                <div><label>Accepted</label><strong><%= fmtN(ov.accepted) %></strong></div>
                <div><label>Rejected</label><strong><%= fmtN(ov.rejected) %></strong></div>
                <div><label>Reject rate</label><strong><%= ov.reject_rate_pct.toFixed(2) %>%</strong></div>
                <div><label>Blocks found</label><strong title="confirmed to be in the chain"><%= fmtN(ov.blocks) %></strong></div>
                <div><label>Best share</label><strong><%= fmtN(Math.round(ov.best_share_24h)) %></strong></div>
            </div>
            <h3 class="subhead">Lifetime</h3>
            <div class="grid grid-sub">
                <div><label>Shares</label><strong><%= fmtN(ov.shares_lifetime) %></strong></div>
                <div><label>Rejects</label><strong><%= fmtN(ov.rejects_lifetime) %></strong></div>
                <div><label>Blocks</label><strong title="confirmed to be in the chain"><%= fmtN(ov.blocks_lifetime) %></strong></div>
                <div><label>Best share ever</label><strong><%= fmtN(Math.round(ov.best_share_lifetime)) %></strong></div>
                <div><label>Tracking since</label><strong title="<%= fmtTs(ov.oldest_share_ts) %>"><%= ago(ov.oldest_share_ts) %></strong></div>
            </div>
            <% if (ov.blocks_orphaned || ov.blocks_rejected || ov.blocks_pending) { %>
            <p class="muted small">
                Candidates that are not blocks:
                <%= fmtN(ov.blocks_orphaned) %> orphaned,
                <%= fmtN(ov.blocks_rejected) %> rejected by the node,
                <%= fmtN(ov.blocks_pending) %> not yet verified.
                Only confirmed blocks are counted above, and only they pay the pool.
            </p>
            <% } %>
        </section>

        <section class="card">
            <h2>Miners by payout address · last 24h</h2>
            <% if (!lbAddr || lbAddr.length === 0) { %>
                <p class="muted">No miners active in the last 24h.</p>
            <% } else { %>
            <div class="tablewrap"><table class="lb">
                <thead>
                    <tr><th>#</th><th>Address</th><th>Rigs</th><th>Shares</th><th>Hashrate</th><th>Pool %</th><th>Last seen</th></tr>
                </thead>
                <tbody>
                <% lbAddr.forEach((m, i) => { %>
                    <tr>
                        <td><%= i + 1 %></td>
                        <td class="mono small"><%= m.address %><% if (m.labels && m.labels.length) { %>
                            <div class="muted small">rigs: <%= m.labels.join(', ') %></div>
                        <% } %></td>
                        <td><%= fmtN(m.rigs) %></td>
                        <td><%= fmtN(m.shares) %></td>
                        <td><%= fmtHashrate(m.hashrate_est) %></td>
                        <td><%= fmtPct(m.share_of_pool_pct) %></td>
                        <td class="nowrap" title="<%= fmtTs(m.last_seen) %>"><%= ago(m.last_seen) %></td>
                    </tr>
                <% }) %>
                </tbody>
            </table></div>
            <% } %>
        </section>

        <section class="card">
            <h2>Worker leaderboard · last 24h <span class="muted small">(per-rig)</span></h2>
            <% if (lb.length === 0) { %>
                <p class="muted">No workers active in the last 24h.</p>
            <% } else { %>
            <div class="tablewrap"><table class="lb">
                <thead>
                    <tr><th>#</th><th>Worker</th><th>Shares (24h)</th><th>5m</th><th>1h</th><th>24h avg</th><th>Pool %</th><th>Last seen</th></tr>
                </thead>
                <tbody>
                <% lb.forEach((w, i) => { %>
                    <tr>
                        <td><%= i + 1 %></td>
                        <td><a href="/worker/<%= encodeURIComponent(w.name) %>"><%= w.name %></a></td>
                        <td><%= fmtN(w.shares) %></td>
                        <td><%= fmtHashrate(w.hashrate_5m) %></td>
                        <td><%= fmtHashrate(w.hashrate_1h) %></td>
                        <td><%= fmtHashrate(w.hashrate_est) %></td>
                        <td><%= fmtPct(w.share_of_pool_pct) %></td>
                        <td class="nowrap" title="<%= fmtTs(w.last_seen) %>"><%= ago(w.last_seen) %></td>
                    </tr>
                <% }) %>
                </tbody>
            </table></div>
            <% } %>
        </section>

        <section class="card">
            <h2>Recent blocks <a class="muted small" href="/blocks" style="float:right">history →</a></h2>
            <% if (blocks.length === 0) { %>
                <p class="muted">No blocks found.</p>
            <% } else { %>
            <div class="tablewrap"><table class="lb">
                <thead><tr><th>Height</th><th>Finder</th><th>Reward</th><th>Status</th><th>Hash</th><th>When</th></tr></thead>
                <tbody>
                <% blocks.forEach(b => { %>
                    <tr>
                        <td><%= fmtN(b.height) %></td>
                        <td><% if (b.finder) { %><a href="/worker/<%= encodeURIComponent(b.finder) %>"><%= b.finder %></a><% } else { %>—<% } %></td>
                        <td class="nowrap"><%= b.status === 'confirmed' ? fmtBtc(b.reward_sats) : '—' %></td>
                        <td class="nowrap"><%- blockStatus(b) %></td>
                        <td class="mono small nowrap" title="<%= b.hash %>"><%= shortHash(b.hash) %></td>
                        <td class="nowrap" title="<%= fmtTs(b.ts) %>"><%= ago(b.ts) %></td>
                    </tr>
                <% }) %>
                </tbody>
            </table></div>
            <% } %>
        </section>
    </main>
    <footer class="foot">
        <span>read-only · auto-refresh 15s</span>
        <span class="sep">·</span>
        <span>built by Layer Two Labs team</span>
        <span class="sep">·</span>
        <a href="https://github.com/LayerTwo-Labs/simplepool" target="_blank" rel="noopener">source on GitHub</a>
    </footer>
</body>
</html>
