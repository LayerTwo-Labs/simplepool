<!doctype html>
<html lang="en">
<head>
<%- include('partial/head', { title: 'admin · tools · simplepool' }) %>
</head>
<body>
<%- include('partial/nav-admin', { active: 'tools' }) %>
<main class="wrap">
    <%- include('partial/flash', { flash }) %>

    <section class="card info">
        <h2>Tools</h2>
        <p class="muted small">
            One-off ops on Thunder. All CSRF-gated; each redirects back
            here with a green/red banner. None of these move money —
            payouts and deposits have their own pages.
        </p>
    </section>

    <section class="card">
        <h2>Nudge Thunder mine</h2>
        <form method="POST" action="/admin/action/nudge-mine">
            <input type="hidden" name="csrf" value="<%= csrfToken %>">
            <input type="hidden" name="return_to" value="/admin/tools">
            <p class="muted small" style="margin:0 0 0.5em 0">
                Call <code>mine</code> on the Thunder RPC once. Thunder
                builds a fresh BMM commit if it can; harmless if it
                can't (the "already exists" error is fine). Complements
                the systemd <code>thunder-mine.timer</code>.
            </p>
            <button type="submit">Nudge mine</button>
        </form>
    </section>

    <section class="card">
        <h2>Remove stale Thunder tx</h2>
        <form method="POST" action="/admin/action/remove-from-mempool" style="max-width:640px">
            <input type="hidden" name="csrf" value="<%= csrfToken %>">
            <input type="hidden" name="return_to" value="/admin/tools">
            <p class="muted small" style="margin:0 0 0.5em 0">
                Drop a stuck tx from Thunder's mempool. Use when a payout
                keeps failing with <code>utxo double spent</code> because
                a phantom tx is holding the reserve UTXO. Thunder's
                mempool is persisted, so a daemon restart doesn't clear
                these — this endpoint does.
            </p>
            <label class="small muted">Thunder txid (64 hex chars)</label>
            <input type="text" name="txid"
                   placeholder="e.g. 914bb27754339954efec…"
                   pattern="[0-9a-fA-F]{64}" required
                   style="width:100%;font-family:monospace;padding:0.35em;margin-bottom:0.5em">
            <button type="submit">Remove from mempool</button>
        </form>
    </section>

    <% if (typeof slipstream !== 'undefined' && slipstream.configured) { %>
    <section class="card">
        <h2>Slipstream: open transactions</h2>
        <p class="muted small" style="margin:0 0 0.5em 0">
            Transactions submitted through slipstream that are not mined
            yet. Withdrawing takes a tx, and any slipstream txs spending it,
            out of the enforcer's mempool, so no template carries it again;
            the slipstream service then records it as dropped
            (<code>withdrawn</code>). Nothing is broadcast either way.
        </p>
        <% if (!slipstream.ok) { %>
            <p class="bad small">The slipstream service is not answering (<%= slipstream.error %>).</p>
        <% } else if (slipstream.txs.length === 0) { %>
            <p class="muted small">Nothing open.</p>
        <% } else { %>
        <table>
            <thead><tr><th>txid</th><th>fee rate</th><th>status</th><th>submitted</th><th></th></tr></thead>
            <tbody>
            <% for (const tx of slipstream.txs) { %>
                <tr>
                    <td class="mono" title="<%= tx.txid %>"><%= tx.txid.slice(0, 16) %>…</td>
                    <td><%= fmtF(tx.fee_rate, 2) %> sat/vB</td>
                    <td><%= tx.status.replace('_', ' ') %></td>
                    <td title="<%= fmtTs(tx.submitted_at) %>"><%= ago(tx.submitted_at) %></td>
                    <td>
                        <% if (slipstreamWithdrawEnabled) { %>
                        <form method="POST" action="/admin/action/slipstream-withdraw" style="margin:0">
                            <input type="hidden" name="csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="return_to" value="/admin/tools">
                            <input type="hidden" name="txid" value="<%= tx.txid %>">
                            <button type="submit">Withdraw</button>
                        </form>
                        <% } else { %><span class="muted small">set ENFORCER_GBT_URL</span><% } %>
                    </td>
                </tr>
            <% } %>
            </tbody>
        </table>
        <% } %>
    </section>
    <% } %>
</main>
<footer class="foot">
    <span>admin · tools</span>
</footer>
</body>
</html>
