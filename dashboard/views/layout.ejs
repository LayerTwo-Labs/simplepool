<%# Generic page shell. Not currently rendered by any route — every view is a
    full document that includes partial/head and partial/nav-* itself — but
    kept in step with them so it cannot come back as the one page without a
    theme. Locals: title, body. %>
<!doctype html>
<html lang="en">
<head>
<%- include('partial/head', { title: (typeof title !== 'undefined' && title) ? title : 'simplepool', refresh: 15 }) %>
</head>
<body>
<%- include('partial/nav-public', { active: '' }) %>
    <main class="wrap">
        <%- body %>
    </main>
    <footer class="foot">
        <span>read-only · auto-refresh 15s</span>
        <span class="sep">·</span>
        <span>built by Layer Two Labs team</span>
        <span class="sep">·</span>
        <a href="https://github.com/LayerTwo-Labs/simplepool" target="_blank" rel="noopener">source on GitHub</a>
    </footer>
</body>
</html>
